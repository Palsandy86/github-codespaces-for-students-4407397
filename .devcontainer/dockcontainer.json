{
    "build": {
        "dockerfile": "Dockerfile"
    },

    "updateContentCommand": "npm install",
    "postCreateCommand": "npm install",

    "remoteUser": "node",

    "forward": [3000],
    "portAtribute": {
        "3000": {
            "label": "React port 3",
            "onAutoForward": "openPreview"
        }

    },

    "customizations": {
        "vscode": {
            "extensions": [
                "esbenp.prettier-vscode"
            ],
            "settings": {
                "editor.formatOnSave": true,
                "editor.defaultFormatter": "esbenp.prettier-vscode"
            }
        }
    }
}